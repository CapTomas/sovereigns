<Project Sdk="Microsoft.NET.Sdk">
  <!-- Renderer-independent simulation tests: run with `dotnet test`, no Godot required (SOV-P01-T04). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Sovereigns.Simulation/Sovereigns.Simulation.csproj" />
    <ProjectReference Include="../../tools/Sovereigns.Headless/Sovereigns.Headless.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
